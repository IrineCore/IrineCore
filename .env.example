# =============================================================================
# IrineCore — Docker Compose Environment Configuration Template
# =============================================================================
# Copy this file to `.env` (gitignored) and adjust paths/credentials for your
# host machine before running `./irine.sh docker up` or `docker compose up -d`.
# =============================================================================

# -----------------------------------------------------------------------------
# Prebuilt Server Container Image (pull with `docker compose pull` or build locally)
# -----------------------------------------------------------------------------
IRINE_SERVER_IMAGE=ghcr.io/irinecore/irinecore-server:latest

# -----------------------------------------------------------------------------
# GameRes (Dragon Nest server resource data) path override
# -----------------------------------------------------------------------------
# Host directory containing GameRes (e.g. Resource/, MapData/, Ext/, etc.).
#   Linux example   : IRINE_GAMERES_PATH=/srv/irinecore/GameRes
#   Windows example : IRINE_GAMERES_PATH=R:/Server/GameRes
IRINE_GAMERES_PATH=./env/GameRes

# Mount path inside the server containers. The container entrypoint writes this
# path into a runtime copy of [Resource] Path= without modifying your host INIs.
IRINE_GAMERES_CONTAINER_PATH=/irinecore/GameRes

# -----------------------------------------------------------------------------
# Network & Public Endpoint Settings (set to your VPS IP for public hosting)
# -----------------------------------------------------------------------------
IRINE_PUBLIC_IP=127.0.0.1
IRINE_PRIVATE_IP=
LOGIN_PORT=14300
VILLAGE_PORT=14400
IRINE_GAME_UDP_START_PORT=15100
GAME_UDP_PORTS=15100-15110

# -----------------------------------------------------------------------------
# Optional host directory overrides & log rotation
# -----------------------------------------------------------------------------
IRINE_CONFIG_PATH=./env/dist/config
IRINE_MODULE_PATH=./env/dist/module
IRINE_SYSTEMS_PATH=./env/dist/systems
IRINE_LOGS_PATH=./env/dist/logs
IRINE_LOG_MAX_MB=50

# -----------------------------------------------------------------------------
# SQL Server 2022 (irine-database)
# -----------------------------------------------------------------------------
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=DnCap60!Local2026
DN_APP_USER=DragonNest
DN_APP_PASSWORD=DnCap60!App2026

# -----------------------------------------------------------------------------
# Nginx Patch & Launcher WebServer (irine-webserver)
# -----------------------------------------------------------------------------
WEBSERVER_PORT=80
