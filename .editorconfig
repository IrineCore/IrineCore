# =============================================================================
# IrineCore — .editorconfig
# =============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,h,hpp,inl}]
indent_style = space
indent_size = 4

[*.{cmake,yml,yaml,json}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.sh]
end_of_line = lf
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
