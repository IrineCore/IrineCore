# =============================================================================
# IrineCore — .gitignore
# =============================================================================

# Build outputs
build/
build-*/
out/
bin/
lib/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/
vcpkg_installed/

# Staged distribution outputs (generated by cmake --install / make install)
env/dist/
env/client/

# Visual Studio / MSVC / IDE artifacts
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb
*.sdf
*.opensdf
*.suo
*.user
*.aps
*.ncb
*.ipch
ipch/
*.obj
*.pch
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.dmp
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Compiled binaries & libraries
*.exe
*.dll
*.lib
*.o
*.a
*.so
*.so.*
*.dylib
*.d
core
core.*

# Keep optional Win32 client runtime DLLs (Bandicam video/capture)
!src/client/engine/BVL/bdvid32.dll
!src/client/engine/BCL/bdcap32.dll

# Large binary game client patch archives (exceeds GitHub 100 MB file-size limit;
# sync locally via deploy/webserver/scripts/sync-patches.{ps1,sh})
*.pak

# Runtime logs, PIDs & temporary files
Log/
logs/
run/
*.log
*.pid
*.tmp
*.bak
*.swp
*~

# Environment & local secrets (commit .env.example templates instead)
.env
.env.local
deploy/mssql/.env
deploy/webserver/.env

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
