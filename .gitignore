# =============================================================================
# IrineCore — .gitignore
# =============================================================================

# Build outputs (anchored to repo root so source subdirs like lib/, bin/, core/ are never ignored)
/build/
/build-*/
/out/
/bin/
/lib/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Testing/
/_deps/
/vcpkg_installed/

# Staged distribution outputs (generated by cmake --install / make install)
/env/dist/
/env/client/
/env/GameRes/

# Visual Studio / MSVC / IDE artifacts
.vs/
.vscode/
.idea/
*.VC.db
*.VC.opendb
*.sdf
*.opensdf
*.suo
*.user
*.aps
*.ncb
*.ipch
ipch/
*.obj
*.pch
*.pdb
*.idb
*.ilk
*.exp
*.tlog
*.dmp
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Compiled binaries & libraries
*.exe
*.dll
*.lib
*.o
*.a
*.so
*.so.*
*.dylib
*.d
/core
core.[0-9]*

# Keep client runtime DLLs (BandiVideoLibrary 2.1.5.19 & BandiCaptureLibrary 3.1.3.334)
!src/client/engine/BVL/bdvid32.dll
!src/client/engine/BVL/bdvid64.dll
!src/client/engine/BCL/bdcap32.dll
!src/client/engine/BCL/bdcap64.dll
!src/client/engine/BCL/amf-*.dll

# Large binary game client patch archives (exceeds GitHub 100 MB file-size limit;
# sync locally via deploy/webserver/scripts/sync-patches.{ps1,sh})
*.pak

# Runtime logs, PIDs & temporary files
/Log/
/logs/
/run/
*.log
*.pid
*.tmp
*.bak
*.swp
*~

# Environment & local secrets (commit .env.example templates instead)
.env
.env.local
conf/config.sh
conf/config.ps1
docker-compose.override.yml
deploy/mssql/.env
deploy/webserver/.env

# Python bytecode
__pycache__/
*.pyc

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
