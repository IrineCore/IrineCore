/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_DRAGONNEST          ICON                    "..\\..\\..\\data\\icons\\DragonNest.ico"
IDI_SMALL               ICON                    "..\\..\\..\\data\\icons\\DragonNest.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_DRAGONNEST MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 22, 17, 230, 75
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    ICON            IDI_DRAGONNEST,IDC_MYICON,14,9,21,20
    LTEXT           "DragonNest Version 1.0",IDC_STATIC,49,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2007",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
END

IDD_DEBUGDLG DIALOGEX 0, 0, 365, 231
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Debug Task"
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    EDITTEXT        IDC_EDIT2,7,196,351,12,ES_MULTILINE | ES_AUTOHSCROLL | ES_WANTRETURN
    CONTROL         "Scroll Lock",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,7,214,52,11
    CONTROL         "",IDC_EDIT1,"RichEdit20W",WS_BORDER | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | 0x11c4,7,7,351,181
END

IDD_DIALOG_REPORT DIALOGEX 0, 0, 335, 143
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST | WS_EX_STATICEDGE
CAPTION "Crash Report"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Don't Send (&D)",IDCANCEL,250,125,76,14
    DEFPUSHBUTTON   "Send Error Report (&S)",IDOK,168,125,76,14
    LISTBOX         IDC_LIST_TITLE,0,0,335,34,LBS_NOINTEGRALHEIGHT | WS_DISABLED | NOT WS_BORDER | WS_TABSTOP
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDFRAME | WS_GROUP,0,34,337,1
    ICON            "",IDC_STATICICON,304,6,20,20,SS_REALSIZEIMAGE
    CONTROL         "",IDC_RICHEDIT22,"RichEdit20A",ES_MULTILINE | ES_READONLY | ES_NUMBER | WS_TABSTOP,17,4,256,30,WS_EX_TRANSPARENT
    LTEXT           "Static",IDC_STATICMSG,18,40,301,73
END


